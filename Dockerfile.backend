# =====================================================================
# ABC Hospital Survey System — Backend (Express API + PostgreSQL + SPA)
# Multi-stage Dockerfile for Coolify + Traefik deployment
# Serves both the API and the frontend SPA from a single container.
# =====================================================================

# --- Stage 1: Build frontend SPA ---
FROM node:22-alpine AS frontend-builder

ARG VITE_API_BASE=""
ENV VITE_API_BASE=${VITE_API_BASE}

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vite.config.ts index.html ./
COPY src/ src/
COPY public/ public/

RUN npm run build:frontend

# --- Stage 2: Build backend ---
FROM node:22-alpine AS backend-builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src/ src/
COPY server.ts ./

RUN npm run build:backend

# --- Stage 3: Production ---
FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=backend-builder /app/dist/server.cjs /app/dist/server.cjs
COPY --from=backend-builder /app/dist/server.cjs.map /app/dist/server.cjs.map
COPY --from=backend-builder /app/src/server/db/schema.sql /app/dist/schema.sql
COPY --from=frontend-builder /app/dist /app/dist

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3000/health || exit 1

CMD ["node", "dist/server.cjs"]
