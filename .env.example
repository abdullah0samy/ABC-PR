# ---------------------------------------------------------------------------
# ABC Hospital PR System — Environment Variables
# Copy to `.env` (dev) / `.env.test` / `.env.prod` and fill in real values.
# ---------------------------------------------------------------------------

# --- Security ---
# JWT secret used to sign & verify auth tokens. MUST be a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
# Access token lifetime (e.g. "1h", "7d"). Short for production.
JWT_EXPIRES_IN="8h"

# --- Gemini AI (declared but currently not used by code; left for future) ---
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# --- Evolution API (WhatsApp gateway) ---
EVOLUTION_API_URL="https://api.evolution.example.com/message/sendText"
EVOLUTION_API_KEY=""
# Optional: shared secret used by Evolution to sign webhook payloads
# (HMAC-SHA256 of the raw body). When set, inbound webhooks must be signed.
EVOLUTION_WEBHOOK_SECRET=""

# --- Optional runtime behavior ---
# DISABLE_HMR=true disables Vite HMR + file watching (useful for AI agents
# that edit files repeatedly to prevent page flicker during edits).
DISABLE_HMR=""
