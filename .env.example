# =====================================================================
# ABC Hospital Survey System — Environment Variables
# =====================================================================
# Copy this file to .env and fill in real values.
# For Coolify: paste these as environment variables in the service config.
# =====================================================================

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL) — Required by: Backend
# ─────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://survey:survey@survey-db:5432/survey"

# ─────────────────────────────────────────────
# SECURITY — Required by: Backend
# ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="8h"

# ─────────────────────────────────────────────
# APP URL / CORS — Required by: Backend
# ─────────────────────────────────────────────
# Comma-separated list of allowed origins (for CORS + WhatsApp links)
# Examples: https://pr.abchospitaleg.com  or  https://pr.abchospitaleg.com,https://staging.abchospitaleg.com
CORS_ORIGIN="https://pr.abchospitaleg.com"

# ─────────────────────────────────────────────
# EVOLUTION API (WhatsApp) — Required by: Backend
# ─────────────────────────────────────────────
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# FRONTEND — Required by: Frontend (if proxying API)
# ─────────────────────────────────────────────
# VITE_API_BASE="http://localhost:3000"
# (Only needed if frontend and backend are on different origins)
